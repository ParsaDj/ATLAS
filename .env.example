DATABASE_URL=postgresql+psycopg://atlas:atlas@localhost:5432/atlas
ATLAS_BOOTSTRAP_ADMIN_USERNAME=atlas-admin
ATLAS_BOOTSTRAP_ADMIN_PASSWORD=replace-with-at-least-12-characters
ATLAS_TELEMETRY_API_KEY=replace-with-a-long-random-bridge-key
ATLAS_OPERATOR_USERNAME=atlas-admin
ATLAS_OPERATOR_PASSWORD=replace-with-at-least-12-characters
# For an internet-facing deployment, uncomment and replace all placeholder
# values above. Production mode fails fast when its core guards are unsafe.
# ATLAS_ENVIRONMENT=production
# ATLAS_PUBLIC_URL=https://atlas.example.com
# ATLAS_SECURE_COOKIES=1
# Optional: send OpenTelemetry spans to an OTLP/HTTP collector.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Optional model-backed investigation. The deterministic investigator remains
# the default and requires no external service or paid API.
# ATLAS_INVESTIGATOR_MODE=llm
# ATLAS_LLM_API_KEY=replace-with-your-provider-key
# ATLAS_LLM_MODEL=replace-with-a-json-schema-capable-model
# ATLAS_LLM_BASE_URL=https://api.openai.com/v1
# ATLAS_LLM_TIMEOUT_SECONDS=30
